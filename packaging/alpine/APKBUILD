pkgname=wolfetch
pkgver=0.5.0_pre1
pkgrel=0
pkgdesc="Tiny and fast system fetch for Linux and BSD"
url="https://github.com/TrueWulf/wolfetch"
arch="all"
license="GPL-3.0-only"
makedepends="cargo"
source="$pkgname-0.5.0-pre.1.tar.gz::https://github.com/TrueWulf/wolfetch/archive/refs/tags/v0.5.0-pre.1.tar.gz"

build() {
  cargo build --release --locked
}

package() {
  install -Dm755 target/release/wolfetch "$pkgdir/usr/bin/wolfetch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
